# Ek hi backend service ka config — AI chat + crypto trading.
# Copy: cp .env.example .env  (aur values bharein)

# ── AI providers (chat) ─────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GROK_API_KEY=your_grok_api_key_here
GROQ_API_KEY=your_groq_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:5173

# ── Delta Exchange (trading) ────────────────────────────
# Delta Exchange India API credentials
# Get these from https://www.delta.exchange → API Management
DELTA_API_KEY=your_delta_api_key_here
DELTA_SECRET_KEY=your_delta_secret_key_here

# ── User accounts aur exchange keys ─────────────────────
# Users ki exchange API keys isse encrypt hoti hain. Ek baar set karke kabhi mat
# badlein — badli to pehle se judi saari keys khul nahi payengi.
# Banayein: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BYOK_ENCRYPTION_KEY=

# Postgres. Na ho to SQLite file use hoti hai — jo Render free par har deploy par
# mit jaati hai (saare user accounts aur judi keys samet).
# Local: postgresql://<mac-username>@localhost:5432/finowings_desk
DATABASE_URL=
